{
  "name": "shiptrack-worker",
  "version": "1.4.0",
  "description": "Scheduled background jobs for ShipTrack: ERP stock sync, carrier polling, customs submission, digests and housekeeping",
  "main": "src/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "pm2-runtime start ecosystem.config.js",
    "run-job": "node src/index.js --run",
    "build": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.10",
    "axios": "1.7.9",
    "ejs": "2.6.2",
    "express": "4.17.1",
    "form-data": "2.3.3",
    "glob": "7.1.7",
    "jsonpath": "1.1.1",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.21",
    "mailgen": "2.0.15",
    "minimatch": "3.0.4",
    "minimist": "1.2.5",
    "moment": "2.29.1",
    "mongoose": "5.13.20",
    "morgan": "1.10.0",
    "mysql2": "2.3.0",
    "nodemailer": "6.6.2",
    "pm2": "5.1.0",
    "rimraf": "3.0.2",
    "tedious": "16.7.0",
    "uuid": "9.0.1",
    "xml-crypto": "6.0.0",
    "xpath": "0.0.33"
  },
  "devDependencies": {
    "multer": "1.4.5-lts.1",
    "supertest": "7.0.0"
  }
}
